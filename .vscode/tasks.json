{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prepare-run-sage",
      "dependsOn": [
        "stop-sage",
        "start-all-services"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "start-all-services",
      "dependsOn": [
        "docker-compose-up",
        "install-backend-deps",
        "start-backend",
        "install-frontend-deps",
        "deploy-benchmark-containers"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "docker-compose-up",
      "type": "shell",
      "command": "docker compose --profile platform up --build -d session-db platform",
      "options": {
        "cwd": "${workspaceFolder}/src"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "group": "services"
      }
    },
    {
      "label": "install-backend-deps",
      "type": "shell",
      "command": "pip3 install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}/src/Backend"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "group": "services"
      }
    },
    {
      "label": "start-backend",
      "type": "shell",
      "command": "python3 -m src.server",
      "options": {
        "cwd": "${workspaceFolder}/src/Backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Uvicorn running.*|.*Application startup complete.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "group": "services"
      }
    },
    {
      "label": "install-frontend-deps",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/src/Frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "group": "services"
      }
    },
    {
      "label": "deploy-benchmark-containers",
      "type": "shell",
      "command": "python3 benchmark/deploy_containers.py --platform-url http://172.17.0.1:8000",
      "options": {
        "cwd": "${workspaceFolder}/src"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "group": "services"
      }
    },
    {
      "label": "stop-sage",
      "type": "shell",
      "command": "python3 dev/manage_sage.py stop",
      "options": {
        "cwd": "${workspaceFolder}/src"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "group": "services"
      }
    },
    {
      "label": "soft-cleanup",
      "type": "shell",
      "command": "python3 dev/manage_sage.py soft-cleanup",
      "options": {
        "cwd": "${workspaceFolder}/src"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "group": "services"
      }
    },
    {
      "label": "hard-cleanup",
      "type": "shell",
      "command": "python3 dev/manage_sage.py hard-cleanup",
      "options": {
        "cwd": "${workspaceFolder}/src"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "group": "services"
      }
    }
  ]
}