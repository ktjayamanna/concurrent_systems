{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "run-sage",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/src/Frontend",
      "env": {
        "VITE_PLATFORM_BASE_URL": "http://172.17.0.1:8000"
      },
      "console": "integratedTerminal",
      "preLaunchTask": "prepare-run-sage",
      "postDebugTask": "stop-sage",
      "serverReadyAction": {
        "pattern": "Local:.*http://localhost:5173",
        "uriFormat": "http://localhost:5173",
        "action": "openExternally"
      }
    },
    {
      "name": "stop-sage",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/src",
      "command": "python3 -c \"print('stop-sage complete')\"",
      "preLaunchTask": "stop-sage"
    },
    {
      "name": "soft-cleanup",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/src",
      "command": "python3 -c \"print('soft-cleanup complete')\"",
      "preLaunchTask": "soft-cleanup"
    },
    {
      "name": "hard-cleanup",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/src",
      "command": "python3 -c \"print('hard-cleanup complete')\"",
      "preLaunchTask": "hard-cleanup"
    }
  ]
}